<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.MainActivity">

    <ImageView
        android:id="@+id/frame_image_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/black"
        android:scaleType="fitCenter"
        android:contentDescription="@string/image_content_description"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:srcCompat="@tools:sample/avatars" />

    <Button
        android:id="@+id/select_video_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:text="@string/select_video_button_text"
        android:textSize="12sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/select_photo_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:text="@string/select_photo_button_text"
        android:textSize="12sp"
        app:layout_constraintTop_toTopOf="@id/select_video_button"
        app:layout_constraintStart_toEndOf="@id/select_video_button" />

    <Button
        android:id="@+id/stop_video_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:text="@string/stop_video_button_text"
        android:textSize="12sp"
        app:layout_constraintTop_toTopOf="@id/select_photo_button"
        app:layout_constraintStart_toEndOf="@id/select_photo_button" />

    <Button
        android:id="@+id/export_background_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:text="@string/export_background_button_text"
        android:textSize="12sp"
        app:layout_constraintTop_toTopOf="@id/stop_video_button"
        app:layout_constraintStart_toEndOf="@id/stop_video_button" />

    <Button
        android:id="@+id/open_camera_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:text="@string/open_camera_button_text"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/select_video_button"
        app:layout_constraintStart_toStartOf="parent" />





</androidx.constraintlayout.widget.ConstraintLayout>