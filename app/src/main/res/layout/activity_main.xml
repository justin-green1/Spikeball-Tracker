<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/black" tools:context=".ui.MainActivity">
    <!--  Reserves a fixed-width column on the right for the controls. The
             ImageView ends here, so the preview is never underneath a button.  -->
    <androidx.constraintlayout.widget.Guideline android:id="@+id/button_column" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" app:layout_constraintGuide_end="152dp"/>
    <ImageView android:id="@+id/frame_image_view" android:layout_width="0dp" android:layout_height="0dp" android:background="@android:color/black" android:contentDescription="@string/image_content_description" android:scaleType="fitCenter" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toStartOf="@id/button_column" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" tools:srcCompat="@tools:sample/backgrounds/scenic"/>
    <!--  Seven buttons in a packed vertical chain: equal width (0dp between the
             guideline and the parent edge) and equal height (44dp with the
             Material insets zeroed, so the rendered height matches the declared
             one). Sources first, then actions.  -->
    <Button android:id="@+id/open_camera_button" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:insetTop="0dp" android:insetBottom="0dp" android:paddingHorizontal="4dp" android:text="@string/open_camera_button_text" android:textSize="12sp" app:layout_constraintBottom_toTopOf="@id/select_video_button" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="@id/button_column" app:layout_constraintTop_toTopOf="parent" app:layout_constraintVertical_chainStyle="packed"/>
    <Button android:id="@+id/select_video_button" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="12dp" android:layout_marginTop="6dp" android:layout_marginEnd="12dp" android:insetTop="0dp" android:insetBottom="0dp" android:paddingHorizontal="4dp" android:text="@string/select_video_button_text" android:textSize="12sp" app:layout_constraintBottom_toTopOf="@id/select_photo_button" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="@id/button_column" app:layout_constraintTop_toBottomOf="@id/open_camera_button"/>
    <Button android:id="@+id/select_photo_button" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="12dp" android:layout_marginTop="6dp" android:layout_marginEnd="12dp" android:insetTop="0dp" android:insetBottom="0dp" android:paddingHorizontal="4dp" android:text="@string/select_photo_button_text" android:textSize="12sp" app:layout_constraintBottom_toTopOf="@id/stop_video_button" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="@id/button_column" app:layout_constraintTop_toBottomOf="@id/select_video_button"/>
    <Button android:id="@+id/stop_video_button" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="12dp" android:layout_marginTop="6dp" android:layout_marginEnd="12dp" android:insetTop="0dp" android:insetBottom="0dp" android:paddingHorizontal="4dp" android:text="@string/stop_video_button_text" android:textSize="12sp" app:layout_constraintBottom_toTopOf="@id/clear_background_button" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="@id/button_column" app:layout_constraintTop_toBottomOf="@id/select_photo_button"/>
    <Button android:id="@+id/clear_background_button" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="12dp" android:layout_marginTop="6dp" android:layout_marginEnd="12dp" android:insetTop="0dp" android:insetBottom="0dp" android:paddingHorizontal="4dp" android:text="@string/clear_background_button_text" android:textSize="12sp" app:layout_constraintBottom_toTopOf="@id/export_background_button" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="@id/button_column" app:layout_constraintTop_toBottomOf="@id/stop_video_button"/>
    <Button android:id="@+id/export_background_button" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="12dp" android:layout_marginTop="6dp" android:layout_marginEnd="12dp" android:insetTop="0dp" android:insetBottom="0dp" android:paddingHorizontal="4dp" android:text="@string/export_background_button_text" android:textSize="12sp" app:layout_constraintBottom_toTopOf="@id/save_replay_button" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="@id/button_column" app:layout_constraintTop_toBottomOf="@id/clear_background_button"/>
    <Button android:id="@+id/save_replay_button" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="12dp" android:layout_marginTop="6dp" android:layout_marginEnd="12dp" android:insetTop="0dp" android:insetBottom="0dp" android:paddingHorizontal="4dp" android:text="@string/save_replay_button_text" android:textSize="12sp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="@id/button_column" app:layout_constraintTop_toBottomOf="@id/export_background_button"/>
</androidx.constraintlayout.widget.ConstraintLayout>